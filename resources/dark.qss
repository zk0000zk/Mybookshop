/* 深色主题 */
QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMainWindow {
    background-color: #1e1e1e;
}

QToolBar {
    background-color: #252525;
    border-bottom: 1px solid #3a3a3a;
    padding: 4px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 14px;
    color: #d4d4d4;
}

QToolBar QToolButton:hover {
    background-color: #3a3a3a;
}

QToolBar QToolButton:pressed {
    background-color: #4a4a4a;
}

QPushButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 14px;
    color: #d4d4d4;
}

QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #5a5a5a;
}

QPushButton:pressed {
    background-color: #4a4a4a;
}

QPushButton#primaryButton {
    background-color: #2196F3;
    color: #ffffff;
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 20px;
    border-radius: 4px;
}

QPushButton#primaryButton:hover {
    background-color: #1E88E5;
}

QPushButton#primaryButton:pressed {
    background-color: #1976D2;
}

QLineEdit {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: #d4d4d4;
}

QLineEdit:focus {
    border-color: #2196F3;
}

QListWidget, QTreeWidget {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    font-size: 14px;
    color: #d4d4d4;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333d44;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #2196F3;
    color: #ffffff;
}

QScrollArea {
    background-color: #1e1e1e;
    border: none;
}

QFrame#bookshelfContainer {
    background-color: #1e1e1e;
}

QFrame#bookCard {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
}

QFrame#bookCard:hover {
    border-color: #2196F3;
}

QTextBrowser {
    background-color: #1e1e1e;
    border: none;
    color: #d4d4d4;
    font-size: 16px;
}

QProgressBar {
    background-color: #3a3a3a;
    border: none;
    border-radius: 2px;
    text-align: center;
    font-size: 12px;
    color: #aaaaaa;
}

QProgressBar::chunk {
    background-color: #2196F3;
    border-radius: 2px;
}

QLabel {
    color: #d4d4d4;
    font-size: 14px;
}

QLabel#bookTitle {
    font-size: 15px;
    font-weight: bold;
    color: #e0e0e0;
}

QLabel#bookMeta {
    font-size: 12px;
    color: #888888;
}

QLabel#emptyHint {
    font-size: 16px;
    color: #666666;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #3a3a3a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #2196F3;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #2196F3;
    border-radius: 3px;
}

QMenu {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #d4d4d4;
}

QMenu::item:selected {
    background-color: #2196F3;
    color: #ffffff;
}

QDialog {
    background-color: #2a2a2a;
}

QFrame#divider {
    background-color: #3a3a3a;
    max-height: 1px;
    min-height: 1px;
}
